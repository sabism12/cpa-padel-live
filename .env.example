# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATA_DIR: Optional location for local file storage only. Render production
# uses Supabase instead and does not require a disk.
# DATA_DIR="./data"

# SESSION_SECRET: Required in production for signing staff login sessions.
# Use a private random value of at least 32 characters. Render generates one
# automatically from render.yaml. Never use a public/client-side variable.
# SESSION_SECRET="replace-with-a-long-random-secret"

# INITIAL_ADMIN_PASSWORD: Used only when production creates a brand-new database row.
# Enter this privately in Render. Existing saved state/passwords are never replaced.
# INITIAL_ADMIN_PASSWORD="choose-a-private-admin-password"

# INITIAL_SCOREKEEPER_PIN: Used only when production creates a brand-new database row.
# Enter this privately in Render; never put it in browser/client configuration.
# INITIAL_SCOREKEEPER_PIN="choose-a-private-scorekeeper-pin"

# Production Supabase storage. Server-only values; never use VITE_ prefixes.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"

# Select file locally or Supabase in production. Render sets this to supabase.
# TOURNAMENT_STORAGE="file"

# CORS_ORIGINS: Optional comma-separated list for approved cross-origin tools.
# Same-origin website requests need no CORS setting.
# CORS_ORIGINS="https://approved-tool.example"
